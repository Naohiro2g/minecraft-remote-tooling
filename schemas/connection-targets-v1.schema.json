{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Naohiro2g/minecraft-remote-tooling/schemas/connection-targets-v1.schema.json",
  "title": "Proposed connection targets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_target_id",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_target_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "host",
          "port"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?|[a-fA-F0-9]*:[a-fA-F0-9:]+)$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  }
}
